# ─── Database ────────────────────────────────────────────────
# Supabase Postgres connection string (use the "Transaction" pooler on port 6543 for Prisma)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Supabase Storage ────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL="https://[your-project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"

# ─── File Upload ─────────────────────────────────────────────
# Max file size in bytes (default: 5MB = 5242880)
# Note: UPLOAD_DIR is no longer used — files are stored in Supabase Storage
